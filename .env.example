# Browser (public by design — shipped in the bundle). NEVER put a secret here.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<supabase-publishable-or-anon-key>
VITE_GOOGLE_CLIENT_ID=<google-oauth-client-id>.apps.googleusercontent.com   # Search Console connection only

# Netlify Functions only (server-side, never VITE_)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<supabase-publishable-or-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-or-secret-key>
ANTHROPIC_API_KEY=<anthropic-api-key>
